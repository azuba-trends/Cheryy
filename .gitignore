# ─────────────────────────────────────────────────────────────────────────────
# CHERYY root .gitignore
# ─────────────────────────────────────────────────────────────────────────────
# Build artefacts, virtual environments, and editor noise are NEVER tracked.
# Source code and configuration under backend/, desktop/src/**, desktop/.vscode
# (none), docs/, installer/, skills/, .github/ stays tracked.

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Python virtualenv (any depth)
.venv/
venv/
env/

# ── Node.js / frontend ───────────────────────────────────────────────────────
node_modules/
.npm/
.eslintcache
.stylelintcache
.parcel-cache/
.next/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Frontend build output ────────────────────────────────────────────────────
desktop/dist/

# ── Tauri / Rust ─────────────────────────────────────────────────────────────
desktop/src-tauri/target/
# Tauri builds generate this sidecar locally; commit pipeline rebuilds it.
desktop/src-tauri/cheryy-server.exe
# Cargo.lock is intentionally NOT ignored: Tauri is a binary crate and the
# lockfile guarantees reproducible builds. It will land in a follow-up commit
# once the existing src/lib.rs scaffold gap is resolved.

# ── PyInstaller / installer build output ────────────────────────────────────
dist/

# ── CHERYY runtime data (lives on the user's machine, never the repo) ────────
*.log
logs/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Secrets / local config — must never be committed.
.env
.env.*
secrets.json
secrets.bin
*.pem
*.key
*api_key*

# ── OS / IDE noise ───────────────────────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
*.lock
